<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrueMemoryScope - 真のメモリ診断ツール" Height="800" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#181825" Foreground="#CDD6F4" FontFamily="Yu Gothic UI, Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="8" Padding="16,14" Margin="0,0,0,14" BorderBrush="#313244" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍 TrueMemoryScope" FontSize="22" FontWeight="Bold" Foreground="#89B4FA"/>
                        <TextBlock Text=" - タスクマネージャーで見えない「真のメモリ消費」を可視化" FontSize="13" Foreground="#A6ADC8" VerticalAlignment="Bottom" Margin="10,0,0,3"/>
                    </StackPanel>
                    <TextBlock Text="※タスクマネージャーのプロセス一覧は『プライベートメモリ』のみ集計するため、ゲーム等の大容量ファイルマッピングが隠れます。" FontSize="12" Foreground="#BAC2DE" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="BtnExplain" Content="💡 なぜ数値がズレるのか？" Margin="0,0,10,0" Background="#313244" Foreground="#F9E2AF" FontWeight="SemiBold"/>
                    <Button Name="BtnRefresh" Content="🔄 最新情報に更新 (F5)" Margin="0,0,0,0" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- システム全体のメモリ概要カード -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 物理メモリ使用量カード -->
            <Border Grid.Column="0" Background="#1E1E2E" CornerRadius="8" Padding="14,12" Margin="0,0,10,0" BorderBrush="#313244" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="物理メモリ (RAM) 使用状況" FontSize="12" Foreground="#A6ADC8"/>
                    <TextBlock Name="TxtRamUsage" Text="計算中..." FontSize="22" FontWeight="Bold" Foreground="#F38BA8" Margin="0,4,0,6"/>
                    <ProgressBar Name="PbRamUsage" Height="10" Background="#313244" Foreground="#F38BA8" BorderThickness="0" Margin="0,0,0,6"/>
                    <TextBlock Name="TxtRamDetails" Text="合計: 64 GB | 空き: -- GB" FontSize="11" Foreground="#BAC2DE"/>
                </StackPanel>
            </Border>

            <!-- コミット済みカード -->
            <Border Grid.Column="1" Background="#1E1E2E" CornerRadius="8" Padding="14,12" Margin="0,0,10,0" BorderBrush="#313244" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="コミット済み (仮想メモリ)" FontSize="12" Foreground="#A6ADC8"/>
                    <TextBlock Name="TxtCommitUsage" Text="-- / -- GB" FontSize="18" FontWeight="Bold" Foreground="#FAB387" Margin="0,4,0,4"/>
                    <TextBlock Text="アプリ・OSが予約した全メモリ" FontSize="11" Foreground="#BAC2DE"/>
                </StackPanel>
            </Border>

            <!-- キャッシュ / スタンバイカード -->
            <Border Grid.Column="2" Background="#1E1E2E" CornerRadius="8" Padding="14,12" Margin="0,0,10,0" BorderBrush="#313244" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="スタンバイ / キャッシュ" FontSize="12" Foreground="#A6ADC8"/>
                    <TextBlock Name="TxtCacheUsage" Text="-- GB" FontSize="18" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,4,0,4"/>
                    <TextBlock Text="必要時に即解放される待機領域" FontSize="11" Foreground="#BAC2DE"/>
                </StackPanel>
            </Border>

            <!-- プール (ドライバ・カーネル) カード -->
            <Border Grid.Column="3" Background="#1E1E2E" CornerRadius="8" Padding="14,12" BorderBrush="#313244" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="カーネル プール (非ページ/ページ)" FontSize="12" Foreground="#A6ADC8"/>
                    <TextBlock Name="TxtPoolUsage" Text="-- GB / -- GB" FontSize="18" FontWeight="Bold" Foreground="#CBA6F7" Margin="0,4,0,4"/>
                    <TextBlock Text="ドライバ・OS内部のメモリ" FontSize="11" Foreground="#BAC2DE"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- メイン プロセス一覧データグリッド -->
        <Border Grid.Row="2" Background="#1E1E2E" CornerRadius="8" Padding="14" BorderBrush="#313244" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- コントロールバー (フィルター/検索) -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="プロセス絞り込み: " VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <TextBox Name="TxtFilter" Grid.Column="1" Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="6,4" FontSize="12"/>
                    <CheckBox Name="ChkOnlyHidden" Grid.Column="2" Content="⚠️ 隠れメモリが 1GB 以上のプロセスのみ表示" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#F9E2AF" FontSize="12"/>
                    <Button Name="BtnKill" Grid.Column="4" Content="選択したプロセスを強制終了" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                </Grid>

                <DataGrid Name="GridProcesses" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" Background="#181825" Foreground="#CDD6F4" RowBackground="#181825" AlternatingRowBackground="#1E1E2E"
                          BorderBrush="#313244" BorderThickness="1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                          HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#313244"/>
                            <Setter Property="Foreground" Value="#CDD6F4"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="BorderBrush" Value="#45475A"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="プロセス名" Binding="{Binding Name}" Width="190"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="65">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="🔥 物理メモリ実消費 (WS)" Binding="{Binding WorkingSetStr}" SortMemberPath="WorkingSet64" Width="165">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="タスクマネージャー表示" Binding="{Binding PrivateMemStr}" SortMemberPath="PrivateMem64" Width="165">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="🚨 隠れメモリ (差分)" Binding="{Binding HiddenMemStr}" SortMemberPath="HiddenMB" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="コミット (仮想予約)" Binding="{Binding VirtualMemStr}" SortMemberPath="VirtualMem64" Width="135">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="実行パス" Binding="{Binding Path}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ステータスバー -->
        <Grid Grid.Row="3" Margin="4,10,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="TxtStatus" Text="準備完了" FontSize="12" Foreground="#A6ADC8"/>
            <TextBlock Name="TxtUpdateTime" Grid.Column="1" Text="最終更新: --:--:--" FontSize="12" Foreground="#A6ADC8"/>
        </Grid>
    </Grid>
</Window>
